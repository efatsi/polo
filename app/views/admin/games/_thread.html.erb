<section class="mt-8">
  <div class="flex items-baseline justify-between">
    <h3 class="font-semibold text-gray-100"><%= game.subject %></h3>
    <%= link_to "View on groups.io", game.groupsio_url, class: "text-sm underline underline-offset-4 hover:text-gray-100", target: "_blank", rel: "noopener" %>
  </div>
  <ol class="mt-3 space-y-3">
    <% game.messages.each do |message| %>
      <li class="rounded-lg border border-gray-700 px-4 py-3">
        <p class="text-sm">
          <span class="font-medium text-gray-100"><%= message.author_name %></span>
          <span class="text-gray-500">· <%= message.sent_at.strftime("%a %b %-d, %-l:%M %p") %></span>
        </p>
        <p class="mt-1 whitespace-pre-line text-sm"><%= message.body %></p>
      </li>
    <% end %>
  </ol>
</section>
