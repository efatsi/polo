<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Crozet Polo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/soccer-ball.png" type="image/png">
    <link rel="apple-touch-icon" href="/soccer-ball.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <header class="border-b border-gray-700">
      <nav class="mx-auto flex max-w-2xl items-center px-4 py-4">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold text-gray-100" do %>
          <%= image_tag "/soccer-ball.png", alt: "", class: "h-6 w-6" %>
          Crozet Bike Polo
        <% end %>
      </nav>
    </header>

    <main class="mx-auto max-w-2xl px-4 py-8">
      <% flash.each do |type, message| %>
        <p class="mb-6 rounded-md border px-4 py-2 text-sm <%= type == "alert" ? "border-rose-700 bg-rose-950 text-rose-200" : "border-emerald-700 bg-emerald-950 text-emerald-200" %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
