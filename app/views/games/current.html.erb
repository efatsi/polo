<% content_for :title, "#{public_status(@game)} · Crozet Bike Polo" %>

<section class="py-10 text-center">
  <p class="text-sm font-medium uppercase tracking-wide text-gray-400">Next game</p>
  <h1 class="mt-3 text-5xl font-extrabold tracking-tight sm:text-6xl <%= @game.nil? ? "text-gray-400" : @game.status == "confirmed" ? "text-emerald-300" : "text-amber-300" %>">
    <%= public_status(@game) %>
  </h1>

  <% if @game %>
    <dl class="mx-auto mt-10 grid max-w-3xl gap-6 text-left sm:grid-cols-3">
      <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
        <dt class="text-sm uppercase tracking-wide text-gray-400">When</dt>
        <dd class="mt-1 text-xl font-semibold text-gray-50"><%= game_day(@game) %></dd>
        <dd class="text-lg text-gray-200"><%= game_time(@game) %></dd>
      </div>
      <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
        <dt class="text-sm uppercase tracking-wide text-gray-400">Where</dt>
        <dd class="mt-1 text-xl font-semibold text-gray-50"><%= location_link(@game.location) %></dd>
      </div>
      <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
        <dt class="text-sm uppercase tracking-wide text-gray-400">Who</dt>
        <dd class="mt-1 text-xl font-semibold text-gray-50"><%= @game.playing.size %> in</dd>
      </div>
    </dl>
  <% else %>
    <p class="mt-4 text-gray-400">Nothing on the calendar yet.</p>
  <% end %>

  <p class="mt-12 text-sm text-gray-400">
    Games are organized on the <%= link_to "group's email list", "https://groups.io/g/#{Groupsio.group_name}", class: "underline underline-offset-4 hover:text-gray-100" %>.
  </p>
</section>
